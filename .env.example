# Required: Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Optional: raises GitHub REST API rate limit from 60/hr to 5000/hr
GITHUB_TOKEN=

# Model overrides (defaults are fine for most runs)
AGENT_MODEL=llama-3.3-70b-versatile
AGENT_MODEL_FAST=llama-3.1-8b-instant

# Hard cap on agent iterations per run
MAX_ITERATIONS=25
